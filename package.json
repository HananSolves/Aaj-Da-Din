{
  "name": "aaj-da-din",
  "version": "0.0.1",
  "private": true,
  "description": "Punjabi new-tab extension: today's date in Punjabi calendars, festivals, a daily photo and fact.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-size.ts",
    "build:calendar": "node scripts/build-calendar.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm build:firefox && pnpm size"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "astronomy-engine": "^2.1.19",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
